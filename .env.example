# ==============================================
# BLOCKCHAIN-BASED SUPPLY CHAIN MANAGEMENT SYSTEM
# Environment Variables Configuration
# ==============================================

# ==============================================
# BLOCKCHAIN CONFIGURATION
# ==============================================

# Network Configuration
BLOCKCHAIN_NETWORK=localhost
# Options: localhost, goerli, mumbai, sepolia, mainnet

# RPC URLs for different networks
LOCALHOST_RPC_URL=http://127.0.0.1:8545
GOERLI_RPC_URL=https://goerli.infura.io/v3/YOUR_INFURA_PROJECT_ID
MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Private key for contract deployment and transactions
# WARNING: Never commit real private keys to version control
PRIVATE_KEY=your_private_key_here

# Deployed contract addresses (update after deployment)
CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890

# Etherscan/Polygonscan API keys for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# ==============================================
# BACKEND API CONFIGURATION
# ==============================================

# Server Configuration
PORT=5000
NODE_ENV=development
# Options: development, production, test

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/agrichain
MONGODB_TEST_URI=mongodb://localhost:27017/agrichain_test

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRE=30d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
# For production, use your domain: https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================
# IPFS CONFIGURATION
# ==============================================

# IPFS Node Configuration
IPFS_HOST=127.0.0.1
IPFS_PORT=5001
IPFS_PROTOCOL=http
# For production IPFS service: https://ipfs.infura.io

# IPFS Gateway URL
IPFS_GATEWAY_URL=https://gateway.ipfs.io/ipfs

# IPFS API Authentication (if using hosted IPFS service)
IPFS_PROJECT_ID=your_ipfs_project_id
IPFS_PROJECT_SECRET=your_ipfs_project_secret

# ==============================================
# FILE UPLOAD CONFIGURATION
# ==============================================

# Maximum file size (in bytes)
MAX_FILE_SIZE=10485760
# 10MB = 10 * 1024 * 1024 bytes

# Upload directory
UPLOAD_PATH=uploads

# Allowed file types
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ==============================================
# LOGGING CONFIGURATION
# ==============================================

# Log level
LOG_LEVEL=info
# Options: error, warn, info, verbose, debug, silly

# Log file path
LOG_FILE=logs/app.log

# ==============================================
# EMAIL CONFIGURATION (Optional)
# ==============================================

# SMTP Configuration for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Email sender information
FROM_EMAIL=noreply@agrichain.com
FROM_NAME=AgriChain Support

# ==============================================
# FRONTEND CONFIGURATION
# ==============================================

# API Base URL
VITE_API_BASE_URL=http://localhost:5000/api

# Contract Address (same as above, for frontend)
VITE_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890

# Blockchain Network
VITE_BLOCKCHAIN_NETWORK=localhost

# RPC URL for frontend Web3 connection
VITE_RPC_URL=http://127.0.0.1:8545

# IPFS Gateway URL for frontend
VITE_IPFS_GATEWAY_URL=https://gateway.ipfs.io/ipfs

# ==============================================
# SECURITY CONFIGURATION
# ==============================================

# Session secret (for additional security)
SESSION_SECRET=your_session_secret_here

# CSRF protection
CSRF_SECRET=your_csrf_secret_here

# Encryption key for sensitive data
ENCRYPTION_KEY=your_32_character_encryption_key_here

# ==============================================
# THIRD-PARTY SERVICES (Optional)
# ==============================================

# Google Maps API (for location services)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Weather API (for farm conditions)
WEATHER_API_KEY=your_weather_api_key

# SMS Service (for notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ==============================================
# MONITORING & ANALYTICS (Optional)
# ==============================================

# Sentry for error tracking
SENTRY_DSN=your_sentry_dsn_url

# Google Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X

# ==============================================
# DEPLOYMENT CONFIGURATION
# ==============================================

# Domain configuration for production
DOMAIN=yourdomain.com
SUBDOMAIN=api.yourdomain.com

# SSL/TLS Configuration
SSL_KEY_PATH=/path/to/ssl/private.key
SSL_CERT_PATH=/path/to/ssl/certificate.crt

# Load balancer configuration
LOAD_BALANCER_IP=your_load_balancer_ip

# ==============================================
# DOCKER CONFIGURATION
# ==============================================

# Docker-specific environment variables
DOCKER_MONGODB_URI=mongodb://mongodb:27017/agrichain
DOCKER_IPFS_HOST=ipfs
DOCKER_BACKEND_URL=http://backend:5000

# ==============================================
# TESTING CONFIGURATION
# ==============================================

# Test database
TEST_MONGODB_URI=mongodb://localhost:27017/agrichain_test

# Test blockchain network
TEST_RPC_URL=http://127.0.0.1:8545

# Test private key (for testing only)
TEST_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ==============================================
# DEVELOPMENT TOOLS
# ==============================================

# Debug mode
DEBUG=agrichain:*

# Hot reload
HOT_RELOAD=true

# API documentation
ENABLE_SWAGGER=true

# ==============================================
# BACKUP CONFIGURATION
# ==============================================

# Database backup
BACKUP_SCHEDULE=0 2 * * *
# Daily at 2 AM (cron format)

BACKUP_RETENTION_DAYS=30

# AWS S3 for backups (optional)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your-backup-bucket
AWS_REGION=us-east-1

# ==============================================
# NOTES
# ==============================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env files with real credentials to version control
# 3. Use different values for development, staging, and production
# 4. Regularly rotate secrets and API keys
# 5. Use environment-specific configurations for different deployments