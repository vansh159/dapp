{
  "name": "agricultural-supply-chain",
  "version": "1.0.0",
  "description": "Blockchain-based Supply Chain Management System for Agricultural Products",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
